{
  "routes": [
    { "path": "/api/v1/auth", "upstream": "appwrite", "auth": "oidc", "scopes": ["auth.read", "auth.write"] },
    { "path": "/api/v1/compute", "upstream": "compute-service", "auth": "jwt", "scopes": ["compute.read", "compute.write"] },
    { "path": "/api/v1/vm", "upstream": "vm-service", "auth": "jwt", "scopes": ["vm.read", "vm.write"] },
    { "path": "/api/v1/network", "upstream": "network-service", "auth": "jwt", "scopes": ["network.read", "network.write"] },
    { "path": "/api/v1/storage", "upstream": "storage-service", "auth": "jwt", "scopes": ["storage.read", "storage.write"] },
    { "path": "/api/v1/kubernetes", "upstream": "kubernetes-service", "auth": "jwt", "scopes": ["kubernetes.read", "kubernetes.write"] },
    { "path": "/api/v1/database", "upstream": "database-service", "auth": "jwt", "scopes": ["database.read", "database.write"] }
  ],
  "transport": {
    "http2": true,
    "websocket": true,
    "grpc": true,
    "metrics": "/metrics",
    "requestLogging": true
  }
}
